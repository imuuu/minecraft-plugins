<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.imu</groupId>
    <artifactId>minecraft-plugins</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Imu Minecraft Plugins</name>
    <description>Paper plugins for the Drevaria server, built as one reactor on top of ImusAPI</description>

    <modules>
        <module>libs/ImusAPI</module>
        <module>plugins/DontLoseItems</module>
        <module>plugins/ImusChallenges</module>
        <module>plugins/ImusEnchants</module>
        <module>plugins/imusGS</module>
        <module>plugins/imusMcCards</module>
        <module>plugins/imusSpawners</module>
        <module>plugins/imusTNT</module>
        <module>plugins/imusWaystones</module>
    </modules>

    <properties>
        <!-- Paper 26.x requires Java 25 at runtime. -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Where packaged jars are written. Defaults to each module's own
             target/ dir; point it at a server to deploy straight into it:
             mvn package -Dplugin.output.dir=E:/McServerThings/Server1.20.1/plugins -->
        <plugin.output.dir>${project.build.directory}</plugin.output.dir>

        <!-- Minecraft version the plugins target. Bump to move to a newer Paper;
             pick a *-stable build from repo.papermc.io. -->
        <paper.version>26.2.build.129-stable</paper.version>
        <ormlite.version>6.1</ormlite.version>
        <hikaricp.version>5.0.1</hikaricp.version>
        <commons.lang3.version>3.14.0</commons.lang3.version>
        <vaultapi.version>1.7</vaultapi.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- VaultAPI is only published through JitPack. -->
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>me.imu</groupId>
                <artifactId>ImusAPI</artifactId>
                <version>${project.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>io.papermc.paper</groupId>
                <artifactId>paper-api</artifactId>
                <version>${paper.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.github.MilkBowl</groupId>
                <artifactId>VaultAPI</artifactId>
                <version>${vaultapi.version}</version>
                <scope>provided</scope>
                <exclusions>
                    <!-- VaultAPI 1.7 pulls org.bukkit:bukkit:1.13.1, which shadows
                         paper-api on the compile classpath and hides everything
                         added to Material/EntityType/ItemMeta since 1.13. -->
                    <exclusion>
                        <groupId>org.bukkit</groupId>
                        <artifactId>bukkit</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.j256.ormlite</groupId>
                <artifactId>ormlite-jdbc</artifactId>
                <version>${ormlite.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons.lang3.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Every module is a Paper plugin or a library for one. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!-- In-process javac 25 crashes (NPE in UnsharedNameTable)
                             while formatting some deprecation warnings on
                             DontLoseItems; a forked javac does not. -->
                        <fork>true</fork>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <!-- 3.6+ ships an ASM that can read Java 25 class files. -->
                    <version>3.6.2</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                            <configuration>
                                <createDependencyReducedPom>false</createDependencyReducedPom>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                    <configuration>
                        <outputDirectory>${plugin.output.dir}</outputDirectory>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- Every module here shaded its compile-scope dependencies into the
                 plugin jar before this reactor existed; keep that behaviour. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
